# Lokální databáze
DB_PATH=aotcse_local.db

# Připojení k lokální Ollamě (z pohledu Dockeru na hostitelský systém Windows)
OLLAMA_URL=http://host.docker.internal:11434/api/generate
LLM_MODEL=qwen3.5:4b

# Webhook pro Make.com nebo Zapier (vložte svou reálnou URL)
WEBHOOK_URL=https://hook.eu1.make.com/VASE_WEBHOOK_URL

# Hardwarová optimalizace pro váš Intel Xeon E3-1535M (4 fyzická jádra)
OMP_NUM_THREADS=4